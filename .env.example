# Required for answering questions (indexing and retrieval run locally without it)
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# EFFORT=low
# TOP_K=6
# MIN_RERANK_SCORE=-2.0
# CHUNK_WORDS=180
# CHUNK_OVERLAP=40

# Use a Qdrant server instead of the embedded on-disk store (set automatically in docker-compose)
# QDRANT_URL=http://localhost:6333
